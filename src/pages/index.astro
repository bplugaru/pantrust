---
import CtaSection from '../components/CtaSection.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { benefits, productHref, products, projects, quotes, reasons } from '../data/site';
import Base from '../layouts/Base.astro';
---
<Base
  title="Pantrust Romania — Panouri sandwich și construcții industriale"
  description="Panouri termoizolante, structuri metalice și accesorii, cu livrare în toată România. Soluții complete pentru construcții industriale."
>
  <section class="hero hero--home">
    <div class="hero__photo"><Photo name="hero.png" alt="" loading="eager" /></div>
    <div class="hero__shade"></div>
    <Header active="home" />
    <div class="container hero__content">
      <h1>Panouri sandwich și soluții complete pentru <span class="accent">construcții industriale</span></h1>
      <p class="hero__lead">Panouri termoizolante  •  Structuri metalice  •  Accesorii<br />Livrare în toată România</p>
      <div class="hero__actions">
        <a href="#contact" class="btn btn--primary btn--lg">Solicită ofertă <Icon name="arrow" size={18} /></a>
        <a href="#produse" class="btn btn--outline btn--lg">Vezi produsele</a>
      </div>
    </div>
    <div class="container hero__benefits">
      {benefits.map((b) => (
        <div class="benefit">
          <Icon name={b.icon} size={34} stroke={1.5} />
          <div>
            <div class="benefit__title">{b.title}</div>
            <div class="benefit__text">{b.text}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <main>
    <section id="produse" class="section">
      <div class="container">
        <div class="section-head">
          <div>
            <div class="eyebrow">Produsele noastre</div>
            <h2 class="section-title">Soluții pentru orice tip de construcție</h2>
          </div>
          <a href="/produse/" class="more-link">Vezi toate produsele <Icon name="arrow" /></a>
        </div>
        <div class="product-grid">
          {products.map((p) => (
            <article class="product-card">
              <div class:list={['product-card__img', { 'on-tile': p.cutout }]}><Photo name={p.img} alt={p.title} contain={p.cutout} /></div>
              <div class="product-card__body">
                <h3>{p.title}</h3>
                <p>{p.text}</p>
                <a href={productHref(p.id)} aria-label={`Vezi detalii: ${p.title}`}>Vezi detalii <Icon name="arrow" size={14} /></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="portofoliu" class="section section--tint">
      <div class="container">
        <div class="section-head">
          <div>
            <div class="eyebrow">Portofoliu</div>
            <h2 class="section-title">Proiecte realizate în toată România</h2>
          </div>
          <a href="/portofoliu/" class="more-link">Vezi toate proiectele <Icon name="arrow" /></a>
        </div>
        <div class="project-grid project-grid--fit">
          {projects.slice(0, 3).map((pr) => (
            <a href="/portofoliu/" class="project-card">
              <ProjectCard img={pr.img} type={pr.type} title={pr.title} meta={pr.place} />
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="de-ce" class="section">
      <div id="despre" class="container why">
        <div>
          <div class="eyebrow">De ce Pantrust</div>
          <h2 class="section-title why__title">Mai mult decât panouri sandwich</h2>
          <p class="why__text">Oferim soluții complete, adaptate fiecărui proiect, cu focus pe calitate, durabilitate și eficiență.</p>
        </div>
        <div class="why__reasons">
          {reasons.map((r) => (
            <div class="reason">
              <Icon name={r.icon} size={34} stroke={1.5} />
              <h3>{r.title}</h3>
              <p>{r.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="feedback" class="testimonials" data-testimonials>
      <div class="testimonials__main">
        <div>
          <div class="eyebrow">Ce spun clienții noștri</div>
          <h2 class="testimonials__title">Încredere prin rezultate</h2>
          <div class="testimonials__rule"></div>
          <div class="testimonials__nav">
            <button type="button" class="round-btn" data-dir="-1" aria-label="Anterior"><Icon name="chevron-left" /></button>
            <button type="button" class="round-btn" data-dir="1" aria-label="Următor"><Icon name="chevron-right" /></button>
            <span class="testimonials__count" data-count>1 / {quotes.length}</span>
          </div>
          <a href="/feedback/" class="more-link testimonials__all">Vezi toate părerile <Icon name="arrow" /></a>
        </div>
        <div class="testimonials__quotes">
          {quotes.map((q, i) => (
            <figure class:list={{ 'is-active': i === 0 }}>
              <div class="testimonials__mark" aria-hidden="true">“</div>
              <blockquote>{q.text}</blockquote>
              <figcaption><strong>{q.who}</strong><span>{q.role}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
      <div class="testimonials__photo"><Photo name="testi.jpg" alt="" /></div>
    </section>

    <CtaSection />
  </main>

  <Footer />
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-testimonials]')!;
  const slides = [...root.querySelectorAll('figure')];
  const count = root.querySelector<HTMLElement>('[data-count]')!;
  let current = 0;
  const go = (dir: number) => {
    slides[current].classList.remove('is-active');
    current = (current + dir + slides.length) % slides.length;
    slides[current].classList.add('is-active');
    count.textContent = `${current + 1} / ${slides.length}`;
  };
  let timer = setInterval(() => go(1), 7000);
  root.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((btn) =>
    btn.addEventListener('click', () => {
      go(Number(btn.dataset.dir));
      clearInterval(timer);
      timer = setInterval(() => go(1), 7000);
    }),
  );
</script>
