---
import CtaSection from '../components/CtaSection.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import { productHref, products, solutions } from '../data/site';
import Base from '../layouts/Base.astro';

const productTitle = (id: string) => products.find((p) => p.id === id)!.title;

const included = [
  { icon: 'helmet', title: 'Consultanță și ofertă rapidă', text: 'Alegem împreună tipul de panou, grosimea și accesoriile potrivite proiectului.' },
  { icon: 'layers', title: 'Panouri și structură', text: 'Panouri sandwich pentru perete și acoperiș, plus structura metalică a construcției.' },
  { icon: 'box', title: 'Accesorii de montaj', text: 'Profile de finisaj, elemente pluviale și elemente de prindere, în culorile panourilor.' },
  { icon: 'truck', title: 'Transport organizat', text: 'Ne ocupăm de organizarea transportului, cu livrare în toată România.' },
] as const;

const advantages = [
  'Mai puțin oțel sau beton armat în structura de rezistență',
  'Timp de execuție redus al construcției',
  'Costuri reduse pentru încălzire și răcire',
  'Fără cheltuielile de întreținere specifice construcțiilor din materiale clasice',
  'Izolația termică, fonică și hidrofugă, aspectul și culoarea se păstrează pe termen lung',
];
---
<Base
  title="Soluții — Pantrust Romania"
  description="Soluții complete pentru hale industriale, depozite frigorifice, construcții agricole și spații comerciale: panouri, structură, accesorii și transport."
>
  <section class="hero hero--page">
    <div class="hero__photo"><Photo name="structuri.jpg" alt="" loading="eager" /></div>
    <div class="hero__shade"></div>
    <Header active="solutii" />
    <div class="container hero__content">
      <nav class="breadcrumb breadcrumb--light" aria-label="Breadcrumb">
        <a href="/">Acasă</a><span>/</span><span aria-current="page">Soluții</span>
      </nav>
      <h1>Totul pentru construcția ta, <span class="accent">dintr‑un singur loc</span></h1>
      <p class="hero__lead">Panouri, structură, accesorii și transport, gândite împreună pentru tipul tău de clădire.</p>
    </div>
  </section>

  <main class="grow">
    <section class="section">
      <div class="container">
        <div class="eyebrow">Soluție completă</div>
        <h2 class="section-title">Ce primești de la Pantrust</h2>
        <div class="included">
          {included.map((s) => (
            <div class="reason">
              <Icon name={s.icon} size={34} stroke={1.5} />
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--tint">
      <div class="container">
        <div class="section-head">
          <div>
            <div class="eyebrow">Pe tip de construcție</div>
            <h2 class="section-title">Ce produse intră în proiectul tău</h2>
          </div>
          <a href="/produse/" class="more-link">Vezi toate produsele <Icon name="arrow" /></a>
        </div>
        <div class="solutions">
          {solutions.map((s) => (
            <article class="solution">
              <div class:list={['solution__img', { 'on-black': s.dark }]}><Photo name={s.img} alt="" contain={s.dark} /></div>
              <div class="solution__body">
                <h3>{s.title}</h3>
                <p>{s.text}</p>
                <div class="chips">
                  {s.prods.map((id) => <a href={productHref(id)}>{productTitle(id)}</a>)}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container about">
        <div>
          <div class="eyebrow">Avantaje</div>
          <h2 class="section-title">De ce panouri termoizolante</h2>
          <ul class="checks checks--lg">
            {advantages.map((a) => <li><Icon name="check" size={18} />{a}</li>)}
          </ul>
        </div>
        <div class="next-steps">
          <a href="/despre-noi/" class="next-step"><span><small>Cum lucrăm</small><strong>De la proiect la hală</strong></span><Icon name="arrow" /></a>
          <a href="/portofoliu/" class="next-step"><span><small>Portofoliu</small><strong>Proiecte realizate</strong></span><Icon name="arrow" /></a>
          <a href="/feedback/" class="next-step"><span><small>Feedback</small><strong>Ce spun clienții noștri</strong></span><Icon name="arrow" /></a>
        </div>
      </div>
    </section>
  </main>

  <CtaSection />
  <Footer />
</Base>
